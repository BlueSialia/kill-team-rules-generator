#!/bin/sh
set -eu

commit_message_file="$1"
first_line=$(sed -n '1p' "$commit_message_file")

if ! printf '%s\n' "$first_line" | grep -Eq '^(feat|fix|refactor|docs|test|build|ci|chore|perf|style|revert)(\([[:alnum:]./_-]+\))?!?: [^[:space:]].*$'; then
  printf '%s\n' 'Commit message must follow Conventional Commits.' >&2
  exit 1
fi
